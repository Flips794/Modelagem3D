# Modelo do arquivo de ambiente de PRODUÇÃO. Copie para backend/.env.production (ignorado pelo git):
#   cp backend/.env.production.example backend/.env.production && chmod 600 backend/.env.production
# Nunca reutilize a senha de desenvolvimento. Gere uma nova (hexadecimal, segura dentro da URL do banco):
#   openssl rand -hex 32

# Senha do PostgreSQL de produção (obrigatória).
POSTGRES_PASSWORD=CHANGE_ME

# Domínio público (o Caddy obtém o certificado HTTPS sozinho). Para teste local sem domínio: :80
SITE_ADDRESS=modelagem3d.exemplo.org

# Portas publicadas pelo Caddy (as únicas portas abertas da pilha).
HTTP_PORT=80
HTTPS_PORT=443

# Interface e API no mesmo domínio: nenhuma origem CORS é necessária.
BACKEND_CORS_ORIGINS=[]

# 1 processo: o estado da animação 3D entre trechos fica na memória do processo.
UVICORN_WORKERS=1

# Opcionais: limite de corpo (bytes) e limites de recursos por serviço.
# MAX_REQUEST_BYTES=2000000
# BACKEND_CPUS=1.50
# BACKEND_MEM_LIMIT=1g
# POSTGRES_CPUS=0.50
# POSTGRES_MEM_LIMIT=384m
# FRONTEND_CPUS=0.50
# FRONTEND_MEM_LIMIT=128m

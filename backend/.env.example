APP_ENV=development
# Senha do PostgreSQL usada pelo docker-compose.yml e pela DATABASE_URL abaixo.
# scripts/garantir_env_backend.sh troca CHANGE_ME pela senha real ao criar backend/.env.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://modelagem3d:CHANGE_ME@127.0.0.1:5433/modelagem3d_db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Opcionais (valores padrão entre parênteses) ---
# APP_ENV=production desliga /docs, /redoc, /openapi.json e as rotas de demonstração.
# Maior corpo de requisição aceito, em bytes; acima disso a API responde 413 (2000000).
# MAX_REQUEST_BYTES=2000000
# Força ligar/desligar o WebSocket OpenMM de demonstração (ligado só em development).
# ENABLE_DEMO_ROUTES=false
# Força abrir/fechar as rotas que gravam no banco (abertas só em development: a API não tem login).
# ENABLE_DB_WRITES=false
# Tamanho máximo de uma simulação 3D em production (padrões 2500 partículas, 300 passos, 12 moléculas).
# PUBLIC_MAX_PARTICLES=2500
# PUBLIC_MAX_STEPS=300
# PUBLIC_MAX_MOLECULES=12
# Lidos pelo CMD da imagem: porta (8000), processos do Uvicorn (1) e proxies confiáveis (*).
# PORT=8000
# UVICORN_WORKERS=1
# FORWARDED_ALLOW_IPS=*
